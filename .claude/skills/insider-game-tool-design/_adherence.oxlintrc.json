{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/conversation/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Zen Maru Gothic|M PLUS Rounded 1c|Baloo 2))/i]",
        "message": "Font not provided by the design system. Available: Zen Maru Gothic, M PLUS Rounded 1c, Baloo 2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:new|counter)$/]",
        "message": "<Badge> variant must be one of 'new' | 'counter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:position|hidden|ruleHref|faqHref|onRule|onFaq|ctaHref|onCta|ctaLabel|style|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: position, hidden, ruleHref, faqHref, onRule, onFaq, ctaHref, onCta, ctaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute|static)$/]",
        "message": "<BottomNav> position must be one of 'fixed' | 'absolute' | 'static'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shine|href|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, shine, href, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cta|accent)$/]",
        "message": "<Button> variant must be one of 'cta' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:interactive|dark|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: interactive, dark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:personal|avatar|timestamp|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: personal, avatar, timestamp, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Faq'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|children|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<Faq> doesn't accept that prop. Declared props: summary, children, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|description|style|key|ref|className|style|children)$/]",
        "message": "<RoleCard> doesn't accept that prop. Declared props: image, name, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionDark'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionDark> doesn't accept that prop. Declared props: title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:mascot|links|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: mascot, links, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:mascot|title|homeHref|ctaHref|showCta|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: mascot, title, homeHref, ctaHref, showCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Speech'] > JSXAttribute > JSXIdentifier[name!=/^(?:speaker|avatar|name|children|style|key|ref|className|style|children)$/]",
        "message": "<Speech> doesn't accept that prop. Declared props: speaker, avatar, name, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Speech'] > JSXAttribute[name.name='speaker'] > Literal[value!=/^(?:maru|fudo)$/]",
        "message": "<Speech> speaker must be one of 'maru' | 'fudo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<StepNav> doesn't accept that prop. Declared props: steps, active, onSelect, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
